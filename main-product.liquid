<div class="crumbs">
  <a href="{{ routes.root_url }}">Home</a> <span>/</span>
  <a href="{{ routes.all_products_collection_url }}">Shop</a> <span>/</span>
  {{ product.title }}
</div>

<div class="product">
  <div class="product__gallery">
    {% for image in product.images %}
      <div class="frame">
        <img src="{{ image | image_url: width: 1200 }}" alt="{{ image.alt | default: product.title | escape }}" loading="lazy" style="width:100%;height:100%;object-fit:cover">
      </div>
    {% else %}
      <div class="frame">
        <svg viewBox="0 0 480 600" xmlns="http://www.w3.org/2000/svg">
          <rect width="480" height="600" fill="{{ settings.color_cream }}"/>
          <text x="240" y="310" text-anchor="middle" font-family="serif" font-style="italic" font-size="22" fill="{{ settings.color_blue }}">Upload product images</text>
        </svg>
      </div>
    {% endfor %}
  </div>

  <aside class="product__info">
    <p class="eyebrow">{{ product.vendor | default: 'LapDog' }}</p>
    <h1 class="product__title">{{ product.title }}</h1>
    <p class="product__price">
      {% if product.compare_at_price > product.price %}
        <s>{{ product.compare_at_price | money }}</s> {{ product.price | money }}
      {% else %}
        {{ product.price | money }}
      {% endif %}
    </p>
    <div class="product__desc">{{ product.description }}</div>

    {% form 'product', product %}
      <div class="product__opts">
        {% for option in product.options_with_values %}
          <div>
            <div class="label">{{ option.name }}</div>
            <div class="swatches">
              {% for value in option.values %}
                <button type="button" class="{% if option.selected_value == value %}active{% endif %}"
                        data-option-index="{{ forloop.parentloop.index0 }}" data-option-value="{{ value | escape }}">
                  {{ value }}
                </button>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>

      <select name="id" hidden>
        {% for variant in product.variants %}
          <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>
            {{ variant.title }} - {{ variant.price | money }}
          </option>
        {% endfor %}
      </select>

      <button type="submit" class="btn btn--lg btn--block" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
        {% if product.selected_or_first_available_variant.available %}Add To Bag — {{ product.selected_or_first_available_variant.price | money }}{% else %}Sold Out{% endif %}
      </button>
    {% endform %}

    <p class="muted mt-2" style="font-family:var(--mono);font-size:11px;letter-spacing:.18em;text-transform:uppercase;text-align:center">Ships in 2–5 days · Free returns within 14 days</p>

    <div class="mt-4">
      {% for block in section.blocks %}
        {% if block.type == 'detail' %}
          <details class="acc"{% if forloop.first %} open{% endif %}>
            <summary>{{ block.settings.heading }}</summary>
            <div class="acc__body">{{ block.settings.body }}</div>
          </details>
        {% endif %}
      {% endfor %}
    </div>
  </aside>
</div>

{% schema %}
{
  "name": "Product",
  "settings": [],
  "blocks": [
    {
      "type": "detail",
      "name": "Detail",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Fit & Fabric" },
        { "type": "richtext", "id": "body", "label": "Body", "default": "<p>300 gsm compact-spun cotton. Boxy fit.</p>" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "detail", "settings": { "heading": "Fit & Fabric" } },
      { "type": "detail", "settings": { "heading": "Composition" } },
      { "type": "detail", "settings": { "heading": "Care" } },
      { "type": "detail", "settings": { "heading": "Shipping & Returns" } }
    ]
  }
}
{% endschema %}
