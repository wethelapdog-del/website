<section class="auth">
  <h1>Sign in.</h1>
  <p class="small">Access · The List</p>
  {% form 'customer_login' %}
    {{ form.errors | default_errors }}
    <div class="field"><label>Email</label><input type="email" name="customer[email]" required></div>
    <div class="field"><label>Password</label><input type="password" name="customer[password]" required></div>
    <button type="submit" class="btn btn--lg btn--block">Sign In →</button>
  {% endform %}
  <p class="auth__foot"><a href="{{ routes.account_recover_url }}">Forgot password?</a></p>
  <p class="auth__foot">New here? <a href="{{ routes.account_register_url }}">Create an account →</a></p>
</section>
