<section class="section">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="sec-head__title mixed">{{ section.settings.heading }}</h2>
      </div>
      <a href="{{ routes.collections_url }}" class="btn btn--outline">Shop All →</a>
    </div>
    <div class="grid grid-3">
      {% for block in section.blocks %}
        {% assign coll = collections[block.settings.collection] %}
        <a class="card" href="{{ coll.url | default: '#' }}" data-reveal>
          <div class="card__media">
            {% if block.settings.image %}
              <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ coll.title | escape }}">
            {% elsif coll.image %}
              <img src="{{ coll.image | image_url: width: 1200 }}" alt="{{ coll.title | escape }}">
            {% else %}
              <div style="background:#F1EBD3;height:100%;display:grid;place-items:center;color:#1E1EF0;font-family:serif;font-style:italic;font-size:28px">{{ coll.title | default: 'Collection' }}</div>
            {% endif %}
          </div>
          <div class="card__info">
            <div class="card__name">{{ coll.title | default: block.settings.label }}</div>
            <div class="card__price">{{ coll.products_count }} styles →</div>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "01 · Collections" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Categories." }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image (override)" },
        { "type": "text", "id": "label", "label": "Label (fallback)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Collection list" }]
}
{% endschema %}
