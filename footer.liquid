<section class="newsletter">
  <div class="wrap">
    <p class="eyebrow" style="color:rgba(250,246,231,.7)">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <p style="max-width:520px;margin:0 auto;color:rgba(250,246,231,.85)">{{ section.settings.subheading }}</p>
    {% form 'customer' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="email" name="contact[email]" placeholder="Email address" required>
      <button type="submit">Subscribe →</button>
    {% endform %}
  </div>
</section>

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <h4><em>Lap</em><b>Dog</b></h4>
        <p>{{ section.settings.brand_note }}</p>
      </div>
      {% for block in section.blocks %}
        {% if block.type == 'menu' %}
          <div>
            <h5>{{ block.settings.heading }}</h5>
            <ul>
              {% for link in linklists[block.settings.menu].links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      {% endfor %}
    </div>
    <div class="site-footer__bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
      <span>Made In Limited Quantity</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The List" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Enter the pack." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "First to know. First to fit. Early access to drops and 10% off your first order." },
    { "type": "textarea", "id": "brand_note", "label": "Brand blurb", "default": "Premium wardrobe essentials for the quietly loud. Constructed in limited runs." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "heading": "Shop" } },
      { "type": "menu", "settings": { "heading": "Universe" } },
      { "type": "menu", "settings": { "heading": "Client Services" } },
      { "type": "menu", "settings": { "heading": "Legal" } }
    ]
  }
}
{% endschema %}
