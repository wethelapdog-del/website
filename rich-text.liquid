<section class="section">
  <div class="wrap" style="max-width:720px;text-align:{{ section.settings.align }}">
    {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
    <h2 class="sec-head__title mixed">{{ section.settings.heading }}</h2>
    <div class="editorial__lead mt-2">{{ section.settings.body }}</div>
    {% if section.settings.cta_label != blank %}
      <a href="{{ section.settings.cta_url }}" class="btn mt-2">{{ section.settings.cta_label }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A quiet study." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Editorial paragraph goes here.</p>" },
    { "type": "select", "id": "align", "label": "Alignment", "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"}], "default": "center" },
    { "type": "text", "id": "cta_label", "label": "CTA label" },
    { "type": "url", "id": "cta_url", "label": "CTA link" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
